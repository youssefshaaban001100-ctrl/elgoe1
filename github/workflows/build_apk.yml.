name: Build Flutter APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Unzip Project
        run: |
          unzip EL_JOE_Complete_Project.zip

      - name: Locate Flutter Project
        run: |
          MOBILE_DIR=$(find . -maxdepth 4 -type d -name "mobile" | head -n 1)
          echo "MOBILE_PATH=$MOBILE_DIR" >> $GITHUB_ENV

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.x'
          channel: 'stable'

      - name: Install Dependencies
        run: |
          cd ${{ env.MOBILE_PATH }}
          flutter pub get

      - name: Build APK
        run: |
          cd ${{ env.MOBILE_PATH }}
          flutter build apk --release

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release
          path: ${{ env.MOBILE_PATH }}/build/app/outputs/flutter-apk/app-release.apk
